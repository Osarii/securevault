# Entorno de ejecución (development | test | production)
NODE_ENV=development
PORT=3000

# Proxy inverso (1 en Render/Railway/Fly/Nginx; 0 en local sin proxy)
TRUST_PROXY=0

# Orígenes permitidos para CORS (separados por coma, sin comodines en producción)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base de datos
# Producción (PostgreSQL gestionado con TLS obligatorio, ej. Neon/Render/Supabase):
# DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require
# Desarrollo local (si se omite DATABASE_URL usa SQLite local en ./data/securevault.db):
SQLITE_PATH=./data/securevault.db
DB_SSL_REJECT_UNAUTHORIZED=true
DB_QUERY_TIMEOUT_MS=5000

# Criptografía (generar con: npm run keygen)
# Llave AES-256-GCM de 32 bytes en base64 (versión 1 por defecto)
DATA_ENCRYPTION_KEY=
# Opcional para rotación de llaves sin pérdida de datos: "1:<base64>,2:<base64>"
DATA_ENCRYPTION_KEYS=
ACTIVE_ENCRYPTION_KEY_VERSION=1

# Secreto HMAC-SHA256 de 32+ bytes en base64 para firma de tokens CSRF, JWT cortos e integridad
HMAC_SECRET=

# Sesiones y cookies
SESSION_TTL_MINUTES=120
COOKIE_SECURE=false

# Límites de negocio (OWASP A06)
MAX_NOTES_PER_USER=50
MAX_NOTE_TITLE_LENGTH=150
MAX_NOTE_CONTENT_LENGTH=10000

# Protección contra fuerza bruta y alertas (OWASP A07 / A09)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
ALERT_FAILED_LOGIN_THRESHOLD=5

# Canal externo de alertas (opcional, sujeto a lista blanca SSRF - OWASP A01 / A09)
ALERT_WEBHOOK_URL=
ALLOWED_WEBHOOK_HOSTS=hooks.slack.com,discord.com,api.resend.com
OUTBOUND_TIMEOUT_MS=4000

# Semilla inicial opcional (solo al ejecutar `npm run seed`; NUNCA subir valores reales a Git)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
